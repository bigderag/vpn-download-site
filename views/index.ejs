            <button class="guide-btn" type="button" data-guide="android">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5Z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"/></svg>
              <span>آموزش اتصال</span>
              <span class="guide-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m14 6-6 6 6 6"/></svg></span>
            </button>
          </div>
        </div>
      </article>

      <!-- iOS -->
      <article class="plat-card reveal" data-platform="ios" style="--d:.2s">
        <button class="plat-front" type="button" aria-expanded="false" aria-controls="detail-ios">
          <span class="plat-index" aria-hidden="true">۰۳</span>
          <span class="plat-logo">
            <span class="logo-ring" aria-hidden="true"></span>
            <img src="./logos/ios.png" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">
            <span class="fb" style="display:none" aria-hidden="true">🍎</span>
          </span>
          <span class="pname">آیفون / آیپد</span>
          <span class="psub">iOS 13.0+</span>
          <span class="plat-cta">مشاهده دانلود
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
