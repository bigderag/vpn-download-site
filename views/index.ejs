                  <svg class="fill-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5L7 4.5Z"/></svg>
                </span>
                <span class="dl-copy">
                  <span class="dl-title">Google Play</span>
                  <span class="dl-sub">فروشگاه رسمی گوگل</span>
                </span>
                <span class="dl-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
                </span>
              </a>

              <a href="https://dl.bigderag.ir/files/openvpn-and.apk" class="dl-link" data-dl data-dl-label="APK اندروید">
                <span class="dl-icon" style="--ib:rgba(34,197,94,.12);--ic:#16a34a">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/></svg>
                </span>
                <span class="dl-copy">
                  <span class="dl-title">دانلود مستقیم APK</span>
                  <span class="dl-sub">100 MB · نسخه اندروید</span>
                </span>
                <span class="dl-arrow">
