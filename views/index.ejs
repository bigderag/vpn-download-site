  <!-- Configs -->
  <section class="section configs" id="configs" aria-labelledby="configTitle">
    <div class="sec-head reveal">
      <div class="sec-head-main">
        <span class="sec-kicker"><span class="sec-num">۰۲</span> گام دوم</span>
        <h2 class="sec-title" id="configTitle">کانفیگ آماده را دانلود کنید</h2>
      </div>
      <p class="sec-hint">بعد از نصب برنامه، فایل را وارد کنید</p>
    </div>

    <div class="cfg-grid">

      <article class="cfg-card c1 reveal" style="--d:.06s">
        <span class="cfg-accent" aria-hidden="true"></span>
        <svg class="cfg-watermark" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/></svg>
        <div class="cfg-head">
          <span class="cfg-ico">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/></svg>
          </span>
          <div class="cfg-heading">
            <h3 class="cfg-title">کانفیگ پرسرعت — UDP</h3>
            <span class="cfg-proto">UDP · پورت 80</span>
          </div>
          <span class="cfg-signal" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </div>

        <div class="chips">
          <span class="chip"><span class="chip-dot"></span>UDP 80</span>
