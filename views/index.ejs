<title>دانلود OpenVPN</title>
<meta name="description" content="دانلود OpenVPN و کانفیگ‌های آماده برای ویندوز، اندروید و آیفون — سریع، امن و پایدار.">

<!-- Telegram / WhatsApp / general link-preview tags. -->
<meta property="og:title" content="دانلود OpenVPN">
<meta property="og:description" content="اتصال امن و پرسرعت برای ویندوز، اندروید و آیفون">
<meta property="og:image" content="https://fsdl.ir/og-image.png">
<meta property="og:type" content="website">
<meta property="og:url" content="https://fsdl.ir">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="دانلود OpenVPN">
<meta name="twitter:description" content="اتصال امن و پرسرعت برای ویندوز، اندروید و آیفون">
<meta name="twitter:image" content="https://bigderag.ir/og-image.png">
<meta name="theme-color" content="#eef1fb" id="themeColor">

<link rel="icon" type="image/x-icon" href="./favicon.ico">
<link rel="stylesheet" href="./css/style.css">
<script>
  (function () {
    var root = document.documentElement;
    root.classList.add('js');
    var theme = 'light';
    try {
      var saved = localStorage.getItem('theme');
      theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch (e) {
      theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    root.setAttribute('data-theme', theme);
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', theme === 'dark' ? '#060918' : '#eef1fb');
  })();
</script>
</head>
<body>

<a class="skip-link" href="#platforms">پرش به انتخاب پلتفرم</a>

<!-- Ambient background -->
<div class="backdrop" aria-hidden="true">
  <div class="aurora aurora-1"></div>
  <div class="aurora aurora-2"></div>
  <div class="aurora aurora-3"></div>
  <div class="bg-grid"></div>
  <div class="bg-noise"></div>
  <div class="sparkles" id="sparkles"></div>
</div>
<div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

<div class="progress-bar" aria-hidden="true"><div class="progress-bar-fill" id="progressBarFill"></div></div>

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/" aria-label="دانلود OpenVPN — صفحه اصلی">
      <span class="brand-mark">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.6 3.7 5.3v5.5c0 5.1 3.5 9.8 8.3 11.1 4.8-1.3 8.3-6 8.3-11.1V5.3L12 1.6Z"/><path class="brand-check" d="m8.6 11.7 2.2 2.2 4.6-4.6"/></svg>
      </span>
      <span class="brand-text">دانلود <strong>OpenVPN</strong></span>
      <span class="brand-status"><span class="status-dot"></span>آنلاین</span>
    </a>

    <button class="theme-toggle" id="themeToggle" type="button" aria-label="تغییر حالت روشن و تاریک" aria-pressed="false" title="حالت روشن / تاریک">
      <span class="theme-knob">
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-14.5V1m0 22v-1.5M4.4 4.4 3.3 3.3m17.4 17.4-1.1-1.1M2.5 12H1m22 0h-1.5M4.4 19.6l-1.1 1.1M20.7 3.3l-1.1 1.1"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 14.7A8.5 8.5 0 0 1 9.3 3.6a.7.7 0 0 0-.9-.9A10 10 0 1 0 21.3 15.6a.7.7 0 0 0-.9-.9Z"/></svg>
      </span>
    </button>
  </div>
</header>

<main class="wrap">

  <!-- Hero -->
  <section class="hero" aria-labelledby="heroTitle">
    <div class="hero-badge reveal" style="--d:.04s">
      <span class="live-dot"></span>
      اتصال امن و پرسرعت
      <span class="badge-spark" aria-hidden="true">✦</span>
    </div>

    <h1 class="hero-title" id="heroTitle">
      <span class="title-line title-line-1">دانلود <span class="title-grad" dir="ltr">OpenVPN</span></span>
      <span class="title-line title-line-2">سریع، امن، بدون مرز</span>
    </h1>

    <p class="hero-sub reveal" style="--d:.16s">
      سیستم‌عامل خود را انتخاب کنید و در کمتر از یک دقیقه
      به اینترنت آزاد و امن وصل شوید.
    </p>

    <div class="trust-row reveal" style="--d:.24s">
      <span class="trust">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5M12 14.5v2.5"/></svg>
        رمزنگاری AES-256
      </span>
      <span class="trust">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/></svg>
        سرعت بالا
      </span>
      <span class="trust">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="4.5" width="13" height="10" rx="2"/><rect x="16.5" y="8" width="5" height="11" rx="1.5"/><path d="M6 18.5h6"/></svg>
        همه دستگاه‌ها
      </span>
    </div>

    <a class="scroll-cue reveal" style="--d:.33s" href="#platforms" aria-label="رفتن به بخش انتخاب پلتفرم">
      <span class="scroll-ring">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </span>
      <span>شروع کنید</span>
    </a>
  </section>

  <!-- Platforms -->
  <section class="section platforms" id="platforms" aria-labelledby="platformTitle">
    <div class="sec-head reveal">
      <div class="sec-head-main">
        <span class="sec-kicker"><span class="sec-num">۰۱</span> گام اول</span>
        <h2 class="sec-title" id="platformTitle">پلتفرم خود را انتخاب کنید</h2>
      </div>
      <p class="sec-hint">برای دیدن لینک‌های دانلود، روی کارت بزنید</p>
    </div>

    <div class="plat-grid">

      <!-- Windows -->
      <article class="plat-card reveal" data-platform="win" style="--d:.06s">
        <button class="plat-front" type="button" aria-expanded="false" aria-controls="detail-win">
          <span class="plat-index" aria-hidden="true">۰۱</span>
          <span class="plat-logo">
            <span class="logo-ring" aria-hidden="true"></span>
            <img src="./logos/windows.png" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">
            <span class="fb" style="display:none" aria-hidden="true">🪟</span>
          </span>
          <span class="pname">ویندوز</span>
          <span class="psub">Windows 10 / 11</span>
          <span class="plat-cta">مشاهده دانلود
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg>
          </span>
        </button>

        <div class="plat-detail" id="detail-win" inert>
          <div class="dv-inner">
            <div class="dv-head">
              <span class="dv-logo">
                <img src="./logos/windows.png" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">
                <span class="fb" style="display:none" aria-hidden="true">🪟</span>
              </span>
              <span class="dv-titles">
                <span class="dv-pname">ویندوز</span>
                <span class="dv-sub"><span class="mini-dot"></span>آماده دانلود</span>
              </span>
              <button class="dv-back" type="button" aria-label="بستن جزئیات ویندوز">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17"/></svg>
              </button>
            </div>

            <div class="dv-links">
              <a href="https://dl.bigderag.ir/files/openvpn-pc.msi" class="dl-link" data-dl data-dl-label="نصب‌کننده ویندوز">
                <span class="dl-icon" style="--ib:rgba(0,120,212,.12);--ic:#0078d4">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/></svg>
                </span>
                <span class="dl-copy">
                  <span class="dl-title">دانلود نصب‌کننده</span>
                  <span class="dl-sub">MSI · 120 MB · Windows 10/11</span>
                </span>
                <span class="dl-arrow">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 17v2.5A1.5 1.5 0 0 0 5.5 21h13a1.5 1.5 0 0 0 1.5-1.5V17"/></svg>
                </span>
              </a>
            </div>

            <button class="guide-btn" type="button" data-guide="win">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15.5H6.5A2.5 2.5 0 0 0 4 21V5.5Z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"/></svg>
              <span>آموزش اتصال</span>
              <span class="guide-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m14 6-6 6 6 6"/></svg></span>
            </button>
          </div>
        </div>
      </article>

